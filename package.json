{
  "name": "evolish",
  "private": true,
  "version": "0.1.0",
  "description": "A cross-platform translation and learning desktop application.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:commits": "node --test scripts/validate-commit-message.test.mjs",
    "test:versions": "node --test scripts/check-versions.test.mjs",
    "check": "pnpm lint && pnpm test && pnpm test:commits && pnpm test:versions && pnpm build",
    "setup:git": "node scripts/setup-git.mjs",
    "prepare": "pnpm setup:git",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "jsdom": "^26",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8",
    "vite": "^7.0.4",
    "vitest": "^3",
    "zod-validation-error": "^4.0.2"
  }
}
